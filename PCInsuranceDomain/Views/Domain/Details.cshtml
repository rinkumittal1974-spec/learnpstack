@using PCInsuranceDomain.Data
@using PCInsuranceDomain.Models
@model DomainItem
@{
    var related = Model.RelatedSlugs
        .Select(DomainCatalog.FindBySlug)
        .Where(r => r is not null)
        .Cast<DomainItem>()
        .ToList();
}

<nav aria-label="breadcrumb" class="mt-3">
    <a asp-controller="Domain" asp-action="Index">&larr; Back to all topics</a>
</nav>

<article class="detail-card mt-3">
    <header class="d-flex align-items-start gap-3 mb-3">
        <div class="fs-1" aria-hidden="true">@Model.Icon</div>
        <div>
            <span class="badge text-bg-secondary mb-2">@Model.CategoryLabel</span>
            <h1 class="h2 mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">@Model.Tagline</p>
        </div>
    </header>

    <h2 class="h5 mt-4">Overview</h2>
    <p>@Model.Overview</p>

    <h2 class="h5 mt-4">@(Model.Category == DomainCategory.BusinessEntity ? "What it does" : "What they do")</h2>
    <ul>
        @foreach (var responsibility in Model.Responsibilities)
        {
            <li>@responsibility</li>
        }
    </ul>

    <h2 class="h5 mt-4">Key terms</h2>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var term in Model.KeyTerms)
        {
            <span class="badge rounded-pill text-bg-light border">@term</span>
        }
    </div>

    @if (related.Count > 0)
    {
        <h2 class="h5 mt-4">Related topics</h2>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var item in related)
            {
                <a class="btn btn-outline-primary btn-sm" asp-controller="Domain" asp-action="Details" asp-route-id="@item.Slug">@item.Name</a>
            }
        </div>
    }
</article>
