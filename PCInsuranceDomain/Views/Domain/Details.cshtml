@using PCInsuranceDomain.Data
@using PCInsuranceDomain.Models
@model DomainItem
@{
    var guide = ProcessGuides.For(Model.Slug);
    var examples = RealWorldExamples.For(Model.Slug);
    var workedExamples = WorkedExamples.For(Model.Slug);
    var related = Model.RelatedSlugs
        .Select(DomainCatalog.FindBySlug)
        .Where(r => r is not null)
        .Cast<DomainItem>()
        .ToList();
}

<nav aria-label="breadcrumb" class="mt-3">
    <a asp-controller="Domain" asp-action="Index">&larr; Back to all topics</a>
</nav>

<article class="detail-card mt-3">
    <header class="d-flex align-items-start gap-3 mb-3">
        <div class="tile-icon large accent-@Model.Accent" aria-hidden="true"><i class="bi bi-@Model.Icon"></i></div>
        <div>
            <span class="badge text-bg-secondary mb-2">@Model.CategoryLabel</span>
            <h1 class="h2 mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">@Model.Tagline</p>
        </div>
    </header>

    <h2 class="h5 mt-4">Overview</h2>
    <p>@Model.Overview</p>

    <h2 class="h5 mt-4">@Model.ResponsibilitiesHeading</h2>
    <ul>
        @foreach (var responsibility in Model.Responsibilities)
        {
            <li>@responsibility</li>
        }
    </ul>

    <h2 class="h5 mt-4">Key terms</h2>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var term in Model.KeyTerms)
        {
            <span class="badge rounded-pill text-bg-light border">@term</span>
        }
    </div>

    @if (guide is not null)
    {
        <h2 class="h5 mt-4">Step-by-step process</h2>
        <p>@guide.Intro</p>
        var lastPhase = "";
        var stepNumber = 0;
        foreach (var step in guide.Steps)
        {
            stepNumber++;
            if (step.Phase != lastPhase)
            {
                lastPhase = step.Phase;
                <h3 class="h6 mt-4 text-uppercase text-muted">@step.Phase</h3>
            }
            <div class="process-step">
                <span class="step-number">@stepNumber</span>
                <h3 class="h6 mb-1">@step.Title</h3>
                <p class="small text-muted mb-2"><strong>Who:</strong> @step.Actor &nbsp;|&nbsp; <strong>When:</strong> @step.Timeframe</p>
                <p>@step.Summary</p>
                <ul class="mb-0">
                    @foreach (var detail in step.Details)
                    {
                        <li>@detail</li>
                    }
                </ul>
            </div>
        }

        if (guide.Diagrams.Count > 0)
        {
            <h2 class="h5 mt-4">Diagrams</h2>
            foreach (var diagram in guide.Diagrams)
            {
                <h3 class="h6 mt-3">@diagram.Title</h3>
                <p class="text-muted small">@diagram.Caption</p>
                <div class="diagram-box"><pre class="mermaid">@diagram.MermaidSource</pre></div>
            }
        }
    }

    @if (workedExamples.Count > 0)
    {
        <h2 class="h5 mt-4">Worked examples</h2>
        <p class="text-muted small">The numbers are made up to keep the arithmetic simple.</p>
        foreach (var worked in workedExamples)
        {
            <section class="worked-example">
                <h3 class="h6 mb-1">@worked.Title</h3>
                <p class="formula small mb-2">@worked.Formula</p>
                <p>@worked.Scenario</p>
                <table class="table table-sm mb-2">
                    <tbody>
                        @foreach (var line in worked.Lines)
                        {
                            <tr><td>@line.Label</td><td class="text-end text-nowrap fw-semibold">@line.Value</td></tr>
                        }
                    </tbody>
                </table>
                <p class="mb-1"><strong>Answer:</strong> @worked.Answer</p>
                <p class="text-muted mb-0"><strong>Why it matters:</strong> @worked.Takeaway</p>
            </section>
        }
    }

    @if (examples.Count > 0)
    {
        <h2 class="h5 mt-4">Real-world examples</h2>
        <ul class="list-unstyled">
            @foreach (var example in examples)
            {
                <li class="mb-2"><strong>@example.Name</strong><br /><span class="text-muted">@example.Note</span></li>
            }
        </ul>
    }

    @if (related.Count > 0)
    {
        <h2 class="h5 mt-4">Related topics</h2>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var item in related)
            {
                <a class="btn btn-outline-primary btn-sm" asp-controller="Domain" asp-action="Details" asp-route-id="@item.Slug">@item.Name</a>
            }
        </div>
    }
</article>

@section Scripts {
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.4.0/dist/mermaid.esm.min.mjs';
        mermaid.initialize({ startOnLoad: true, theme: 'neutral', flowchart: { useMaxWidth: true } });
    </script>
}
